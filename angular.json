{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "katarina-komatina": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss",
          "skipTests": true
        },
        "@schematics/angular:class": {
          "skipTests": true
        },
        "@schematics/angular:directive": {
          "skipTests": true
        },
        "@schematics/angular:guard": {
          "skipTests": true
        },
        "@schematics/angular:interceptor": {
          "skipTests": true
        },
        "@schematics/angular:pipe": {
          "skipTests": true
        },
        "@schematics/angular:resolver": {
          "skipTests": true
        },
        "@schematics/angular:service": {
          "skipTests": true
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource/cormorant-garamond/400.css",
              "node_modules/@fontsource/cormorant-garamond/500.css",
              "node_modules/@fontsource/cormorant-garamond/600.css",
              "node_modules/@fontsource/cormorant-garamond/400-italic.css",
              "node_modules/@fontsource/cormorant-garamond/500-italic.css",
              "node_modules/@fontsource/caveat/400.css",
              "node_modules/@fontsource/caveat/500.css",
              "node_modules/@fontsource/caveat/600.css",
              "node_modules/@fontsource/caveat/700.css",
              "node_modules/@fontsource/courier-prime/400.css",
              "node_modules/@fontsource/courier-prime/700.css",
              "node_modules/@fontsource/jost/400.css",
              "node_modules/@fontsource/jost/500.css",
              "node_modules/flag-icons/css/flag-icons.min.css",
              "src/styles.scss"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "600kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "16kB",
                  "maximumError": "32kB"
                }
              ],
              "outputHashing": "all",
              "fileReplacements": [
                {
                  "replace": "src/app/admin.routes.ts",
                  "with": "src/app/admin.routes.prod.ts"
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": true
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "outputHashing": "media"
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "katarina-komatina:build:production"
            },
            "development": {
              "buildTarget": "katarina-komatina:build:development"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}